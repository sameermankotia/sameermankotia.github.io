---
/**
 * FIG. 1, assembled: the plate, its readout, the step table, and the honest
 * reading of what the runs so far actually showed.
 *
 * The step table is the figure's accessible structure, not a caption bolted
 * on. Each row is a real button carrying its own note, so the whole figure is
 * reachable by keyboard and readable by speech without the SVG participating
 * at all — which is why the plate can stay aria-hidden.
 *
 * Below md the plate is not drawn: a 1200-unit figure on a phone renders its
 * 13px lettering at about four. The step table is already a vertical trace of
 * the same pipeline, so on a phone it simply is the figure.
 */
import ToolchainPlate from "./ToolchainPlate.astro";
import { steps, figureDescription, findings, results } from "@/data/toolchain";
import { person, dissertation } from "@/data/site";

const roads = [
  { id: "shared", label: "Front end · shared" },
  { id: "compile", label: "Compile road" },
  { id: "json", label: "JSON road" },
] as const;
---

<figure class="mt-12 sm:mt-16" data-figure>
  <p class="sr-only">{figureDescription}</p>

  <div class="hidden md:block">
    <ToolchainPlate />
  </div>

  <figcaption class="mt-6 border-t border-rule-strong pt-4 md:mt-8">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <span class="t-label shrink-0">Fig. 1 — my dissertation</span>
      <span class="t-label text-muted">
        {dissertation.degree}, {person.lab}
      </span>
    </div>
    <p class="t-small measure mt-2 text-muted">{dissertation.title}</p>
    {/* Two of the eleven boxes are published in their own right. Naming the
        papers here means a reader can check those parts of the drawing
        against peer review without hunting for them further down. */}
    <p class="t-ident mt-3 flex flex-wrap gap-x-5 gap-y-1 text-muted">
      <span>Published parts:</span>
      <a
        href="https://doi.org/10.1109/MCSoC67473.2025.00048"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-rule-strong underline-offset-4 transition-colors hover:text-allow"
        >[08] FlexSiMArch — IEEE MCSoC 2025</a
      >
      <a
        href="https://doi.org/10.1109/CARS67163.2025.11337876"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-rule-strong underline-offset-4 transition-colors hover:text-allow"
        >[04] BHPol — IEEE CARS 2025</a
      >
    </p>
  </figcaption>

  <p
    class="t-body measure mt-5 min-h-[7.5rem] text-muted sm:min-h-[6rem]"
    data-readout
    aria-live="polite"
  >
    Two roads leave the same front end. The top one is what an experiment
    actually runs; the bottom one exists so the tree structure is something a
    reviewer can look at. Both label through the same module &mdash; the
    dashed line &mdash; so a label in a binary and a label in a report cannot
    disagree. Click any step to read it.
  </p>

  <div class="mt-8 grid gap-x-10 gap-y-8 lg:grid-cols-3">
    {
      roads.map((road) => (
        <div>
          <p class="t-label border-b border-rule pb-2 text-muted">
            {road.label}
          </p>
          <ul>
            {steps
              .filter((s) => s.road === road.id)
              .map((step) => (
                <li>
                  <button
                    type="button"
                    data-step-btn={step.step}
                    data-note={step.note}
                    class="group flex w-full flex-wrap items-baseline gap-x-3 border-b border-rule-faint py-2.5 text-left transition-colors hover:text-allow aria-[current=true]:text-allow"
                  >
                    <span class="t-ident shrink-0 text-muted transition-colors group-hover:text-allow group-aria-[current=true]:text-allow">
                      [{step.step}]
                    </span>
                    <span class="t-ident font-semibold">{step.name}</span>
                    <span class="t-ident w-full text-muted sm:w-auto">
                      {step.component}
                    </span>
                    <span class="sr-only">. {step.note}</span>
                  </button>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>

  {/* What the runs showed, stated the way it stands. A detection rate quoted
      without the benign twins, or without the taxonomy limit below it, would
      be a better-looking number and a weaker claim. */}
  <div class="mt-16 border-t border-rule-strong pt-8">
    <h3 class="t-label text-muted">Where this stands</h3>

    <div class="mt-5 overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="t-small pb-3 text-left text-muted">
          {results.caption}
        </caption>
        <thead>
          <tr class="border-b border-rule-strong">
            {
              results.columns.map((column, i) => (
                <th
                  scope="col"
                  class:list={[
                    "t-label py-2 font-semibold",
                    i === 0 ? "pr-6" : "pr-4 text-right",
                  ]}
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            results.rows.map((row) => (
              <tr class="border-b border-rule-faint">
                {row.map((cell, i) => (
                  <td
                    class:list={[
                      "t-ident py-2",
                      i === 0 ? "pr-6" : "pr-4 text-right tabular-nums",
                      i === 0 ? "" : "text-muted",
                    ]}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="t-small measure mt-5 text-muted">{results.reading}</p>

    <h4 class="t-label mt-10 border-b border-rule pb-2 text-muted">
      Three limits in the simulator's enforcement, read out of its own code
    </h4>
    <dl class="mt-2">
      {
        findings.map((finding) => (
          <div class="grid gap-x-8 gap-y-1 border-b border-rule-faint py-4 sm:grid-cols-[11rem_minmax(0,1fr)]">
            <dt class="t-ident">
              <span class="text-allow">{finding.id}</span>
              <span class="ml-2">{finding.title}</span>
            </dt>
            <dd class="t-small measure text-muted">{finding.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</figure>

<script>
  /**
   * One step is live at a time. Pointing previews it; clicking pins it, so
   * the reading survives the pointer leaving. Without that split, a click
   * lands on a row hover has already lit and reads as switching it off.
   */
  const figure = document.querySelector<HTMLElement>("[data-figure]");
  if (figure) {
    const readout = figure.querySelector<HTMLElement>("[data-readout]");
    const buttons = [
      ...figure.querySelectorAll<HTMLButtonElement>("[data-step-btn]"),
    ];
    const parts = [...figure.querySelectorAll<SVGGElement>("[data-step]")];
    const resting = readout?.innerHTML ?? "";

    let pinned: string | null = null;
    let pointed: string | null = null;

    const render = () => {
      const live = pointed ?? pinned;

      for (const part of parts) {
        if (part.dataset.step === live) part.setAttribute("data-live", "");
        else part.removeAttribute("data-live");
      }

      for (const button of buttons) {
        const match = button.dataset.stepBtn === live;
        if (match) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.stepBtn === pinned),
        );
      }

      if (!readout) return;
      if (!live) {
        readout.innerHTML = resting;
        return;
      }
      const source = buttons.find((b) => b.dataset.stepBtn === live);
      // The name is the second span; the first is the bracketed step number.
      const name =
        source?.querySelectorAll("span")[1]?.textContent?.trim() ?? "";
      readout.textContent = "";
      const tag = document.createElement("span");
      tag.className = "t-ident font-semibold text-allow";
      tag.textContent = `[${live}] ${name}. `;
      readout.append(tag, source?.dataset.note ?? "");
    };

    const point = (step: string | null) => {
      pointed = step;
      render();
    };

    const take = (step: string) => {
      pinned = pinned === step ? null : step;
      render();
    };

    for (const button of buttons) {
      const step = button.dataset.stepBtn!;
      button.addEventListener("pointerenter", () => point(step));
      button.addEventListener("pointerleave", () => point(null));
      button.addEventListener("focus", () => point(step));
      button.addEventListener("blur", () => point(null));
      button.addEventListener("click", () => take(step));
    }

    // The plate reports the same two gestures, so a part behaves identically
    // whether it is picked off the drawing or out of the table.
    for (const part of parts) {
      const step = part.dataset.step!;
      part.addEventListener("pointerenter", () => point(step));
      part.addEventListener("pointerleave", () => point(null));
      part.addEventListener("click", () => take(step));
    }

    render();
  }
</script>
