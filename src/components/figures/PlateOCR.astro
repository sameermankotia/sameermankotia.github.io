---
/**
 * Plate — the OCR evaluation harness.
 *
 * The claim the drawing makes is the fan and the converge: one set of
 * documents reaches every configuration unchanged, and every result comes
 * back through the same normalisation before it is scored. That symmetry is
 * the whole reason a difference in the numbers means anything.
 */
---

<svg viewBox="0 0 360 150" fill="none" class="fg-plate w-full" aria-hidden="true" focusable="false">
  <g class="fg-part">
    <rect class="fg-box" x="6" y="58" width="70" height="34"></rect>
    <text class="fg-name" x="41" y="76">Documents</text>
    <text class="fg-sub" x="41" y="88">one set</text>
  </g>

  <!-- Fan: the same input to every configuration -->
  <path class="fg-wire" d="M76 75 H84 M84 39 V111 M84 39 H87 M84 75 H87 M84 111 H87"></path>
  <polygon class="fg-head" points="96,39 87,34 87,44"></polygon>
  <polygon class="fg-head" points="96,75 87,70 87,80"></polygon>
  <polygon class="fg-head" points="96,111 87,106 87,116"></polygon>
  <circle class="fg-head" cx="84" cy="75" r="2.5"></circle>

  <g class="fg-part">
    <rect class="fg-box" x="96" y="28" width="80" height="22"></rect>
    <text class="fg-name" x="136" y="43">config 1</text>
  </g>
  <g class="fg-part">
    <rect class="fg-box" x="96" y="64" width="80" height="22"></rect>
    <text class="fg-name" x="136" y="79">config 2</text>
  </g>
  <g class="fg-part">
    <rect class="fg-box" x="96" y="100" width="80" height="22"></rect>
    <text class="fg-name" x="136" y="115">config n</text>
  </g>

  <!-- Converge: one normalisation, one scoring -->
  <path class="fg-wire" d="M176 39 H192 M176 111 H192 M192 39 V111 M176 75 H197"></path>
  <polygon class="fg-head" points="206,75 197,70 197,80"></polygon>
  <circle class="fg-head" cx="192" cy="75" r="2.5"></circle>

  <g class="fg-part">
    <rect class="fg-fill" x="206" y="58" width="64" height="34"></rect>
    <rect class="fg-box" x="206" y="58" width="64" height="34"></rect>
    <text class="fg-name" x="238" y="76">Score</text>
    <text class="fg-sub" x="238" y="88">normalised</text>
  </g>

  <path class="fg-wire" d="M270 75 H275"></path>
  <polygon class="fg-head" points="284,75 275,70 275,80"></polygon>

  <g class="fg-part">
    <rect class="fg-box" x="284" y="58" width="68" height="34"></rect>
    <text class="fg-name" x="318" y="76">Dashboard</text>
    <text class="fg-sub" x="318" y="88">per document</text>
  </g>
</svg>
