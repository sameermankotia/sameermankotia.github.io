---
/**
 * FIG. 1 — the plate.
 *
 * Three things this drawing has to get right, because they are the design:
 *
 *   1. The symbol table is a hinge, not a stage. Both roads hang off it, so
 *      it is drawn as the point the flow turns rather than another box in a
 *      row.
 *   2. There are two roads, and they are not equals. The compile road is what
 *      an experiment runs; the JSON road exists so the trees are reviewable.
 *      Drawn as two lanes, the compile one above.
 *   3. The dashed link is load-bearing. Both roads label through one module,
 *      which is the reason a label in an ELF and a label in a report cannot
 *      disagree — so it is drawn once, in the middle, touching both.
 *
 * Presentational and aria-hidden. Everything it says is said in the step
 * table beneath it, which is the keyboard and screen-reader route.
 */
---

<svg
  viewBox="0 0 1200 440"
  fill="none"
  class="w-full"
  aria-hidden="true"
  focusable="false"
>
  <text class="fg-zone" x="24" y="26">Front end · shared</text>

  <!-- ===================== SHARED FRONT END ====================== -->
  <g class="fg-part" data-step="01">
    <rect class="fg-box" x="24" y="44" width="200" height="60"></rect>
    <text class="fg-name" x="124" y="70">Preprocess</text>
    <text class="fg-sub" x="124" y="89">Preprocessor.py</text>
    <g class="fg-tag">
      <rect x="100" y="32" width="48" height="16"></rect>
      <text x="124" y="43.5">[ 01 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="02">
    <rect class="fg-box" x="24" y="130" width="200" height="60"></rect>
    <text class="fg-name" x="124" y="156">Parse</text>
    <text class="fg-sub" x="124" y="175">uicc.py · CParser</text>
    <g class="fg-tag">
      <rect x="100" y="118" width="48" height="16"></rect>
      <text x="124" y="129.5">[ 02 ]</text>
    </g>
  </g>

  <!-- The hinge. Filled, because both roads read from it. -->
  <g class="fg-part" data-step="03">
    <rect class="fg-fill" x="24" y="216" width="200" height="60"></rect>
    <rect class="fg-box" x="24" y="216" width="200" height="60"></rect>
    <text class="fg-name" x="124" y="242">Symbol table</text>
    <text class="fg-sub" x="124" y="261">symtab.py</text>
    <g class="fg-tag">
      <rect x="100" y="204" width="48" height="16"></rect>
      <text x="124" y="215.5">[ 03 ]</text>
    </g>
  </g>

  <path class="fg-wire" d="M124 104 V121"></path>
  <polygon class="fg-head" points="124,130 119,121 129,121"></polygon>
  <path class="fg-wire" d="M124 190 V207"></path>
  <polygon class="fg-head" points="124,216 119,207 129,207"></polygon>

  <!-- The shared labeler. Drawn once, between the lanes, touching both. -->
  <g class="fg-part" data-step="04">
    <rect class="fg-fill" x="268" y="216" width="212" height="60"></rect>
    <rect class="fg-box" x="268" y="216" width="212" height="60"></rect>
    <text class="fg-name" x="374" y="242">Canonical labels</text>
    <text class="fg-sub" x="374" y="261">bhpol_labels.py</text>
    <g class="fg-tag">
      <rect x="350" y="204" width="48" height="16"></rect>
      <text x="374" y="215.5">[ 04 ]</text>
    </g>
  </g>

  <path class="fg-wire" d="M224 246 H259"></path>
  <polygon class="fg-head" points="268,246 259,241 259,251"></polygon>

  <!-- ====================== COMPILE ROAD ========================= -->
  <text class="fg-zone" x="1072" y="64" text-anchor="end">
    Compile road · what an experiment runs
  </text>

  <g class="fg-part" data-step="05">
    <rect class="fg-box" x="268" y="86" width="186" height="60"></rect>
    <text class="fg-name" x="361" y="112">Code generation</text>
    <text class="fg-sub" x="361" y="131">RISCVGenerator</text>
    <g class="fg-tag">
      <rect x="337" y="74" width="48" height="16"></rect>
      <text x="361" y="85.5">[ 05 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="06">
    <rect class="fg-box" x="474" y="86" width="186" height="60"></rect>
    <text class="fg-name" x="567" y="112">ELF and tags</text>
    <text class="fg-sub" x="567" y="131">.elf · .telf</text>
    <g class="fg-tag">
      <rect x="543" y="74" width="48" height="16"></rect>
      <text x="567" y="85.5">[ 06 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="07">
    <rect class="fg-box" x="680" y="86" width="186" height="60"></rect>
    <text class="fg-name" x="773" y="112">Corpora</text>
    <text class="fg-sub" x="773" y="131">2,460 cases</text>
    <g class="fg-tag">
      <rect x="749" y="74" width="48" height="16"></rect>
      <text x="773" y="85.5">[ 07 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="08">
    <rect class="fg-fill" x="886" y="86" width="186" height="60"></rect>
    <rect class="fg-box" x="886" y="86" width="186" height="60"></rect>
    <text class="fg-name" x="979" y="112">FlexSiMArch</text>
    <text class="fg-sub" x="979" y="131">run and measure</text>
    <g class="fg-tag">
      <rect x="955" y="74" width="48" height="16"></rect>
      <text x="979" y="85.5">[ 08 ]</text>
    </g>
  </g>

  <!-- Labeling feeds code generation -->
  <path class="fg-wire" d="M374 216 V155"></path>
  <polygon class="fg-head" points="374,146 369,155 379,155"></polygon>

  <path class="fg-wire" d="M454 116 H465"></path>
  <polygon class="fg-head" points="474,116 465,111 465,121"></polygon>
  <path class="fg-wire" d="M660 116 H671"></path>
  <polygon class="fg-head" points="680,116 671,111 671,121"></polygon>
  <path class="fg-wire" d="M866 116 H877"></path>
  <polygon class="fg-head" points="886,116 877,111 877,121"></polygon>

  <!-- ======================== JSON ROAD ========================== -->
  <text class="fg-zone" x="866" y="326" text-anchor="end">
    JSON road · what makes the trees reviewable
  </text>

  <g class="fg-part" data-step="09">
    <rect class="fg-box" x="268" y="348" width="186" height="60"></rect>
    <text class="fg-name" x="361" y="374">Stage 1–3 JSON</text>
    <text class="fg-sub" x="361" y="393">bhpol_pipeline.py</text>
    <g class="fg-tag">
      <rect x="337" y="336" width="48" height="16"></rect>
      <text x="361" y="347.5">[ 09 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="10">
    <rect class="fg-box" x="474" y="348" width="186" height="60"></rect>
    <text class="fg-name" x="567" y="374">Transform</text>
    <text class="fg-sub" x="567" y="393">bhpol_transform.py</text>
    <g class="fg-tag">
      <rect x="543" y="336" width="48" height="16"></rect>
      <text x="567" y="347.5">[ 10 ]</text>
    </g>
  </g>

  <g class="fg-part" data-step="11">
    <rect class="fg-box" x="680" y="348" width="186" height="60"></rect>
    <text class="fg-name" x="773" y="374">Trees and reports</text>
    <text class="fg-sub" x="773" y="393">bhpol_visualize.py</text>
    <g class="fg-tag">
      <rect x="749" y="336" width="48" height="16"></rect>
      <text x="773" y="347.5">[ 11 ]</text>
    </g>
  </g>

  <!-- The symbol table feeds the second road directly -->
  <path class="fg-wire" d="M124 276 V378 H259"></path>
  <polygon class="fg-head" points="268,378 259,373 259,383"></polygon>

  <path class="fg-wire" d="M454 378 H465"></path>
  <polygon class="fg-head" points="474,378 465,373 465,383"></polygon>
  <path class="fg-wire" d="M660 378 H671"></path>
  <polygon class="fg-head" points="680,378 671,373 671,383"></polygon>

  <!-- The dashed link: one label algebra, both roads. This is the line that
       makes the two roads consistent, so it is annotated rather than left to
       be inferred from the dash pattern. -->
  <path class="fg-ghost" d="M440 276 V318 H567 V339"></path>
  <polygon class="fg-head" points="567,348 562,339 572,339"></polygon>
  <circle class="fg-head" cx="440" cy="318" r="3"></circle>
  <text class="fg-sub" x="578" y="314" text-anchor="start"
    >one label algebra, both roads</text
  >
</svg>
