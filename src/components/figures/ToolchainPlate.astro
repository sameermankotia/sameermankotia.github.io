---
/**
 * FIG. 1 — the plate.
 *
 * Two bands with the ELF binary between them, because that is the actual
 * architecture: the policy crosses from compile time to runtime *inside* the
 * artifact. Drawing it as a hand-off bar rather than another box in the row is
 * the one thing this figure has to get right.
 *
 * Two wires leave that bar. `.text` loads into memory, which every toolchain
 * does. `.policy_meta` and `.text_tag` route into the enforcement unit, which
 * is the contribution — so they are drawn as a junction feeding one input,
 * not as decoration along the bottom.
 *
 * Presentational, and aria-hidden. Everything it says is said in the step
 * table beneath it, which is the keyboard and screen-reader route. Pointing at
 * a part here reads the same entry that pointing at its row does.
 */
---

<svg
  viewBox="0 0 1200 500"
  fill="none"
  class="w-full"
  aria-hidden="true"
  focusable="false"
>
  <!-- ======================= COMPILE TIME ======================= -->
  <text class="fg-zone" x="1176" y="22" text-anchor="end">
    Compile time · UICC
  </text>

  <!-- 01 -->
  <g class="fg-part" data-step="01">
    <rect class="fg-box" x="24" y="40" width="192" height="64"></rect>
    <text class="fg-name" x="120" y="67">C source</text>
    <text class="fg-sub" x="120" y="86">#pragma annotated</text>
    <g class="fg-tag">
      <rect x="96" y="28" width="48" height="16"></rect>
      <text x="120" y="39.5">[ 01 ]</text>
    </g>
  </g>

  <!-- 02 -->
  <g class="fg-part" data-step="02">
    <rect class="fg-box" x="240" y="40" width="192" height="64"></rect>
    <text class="fg-name" x="336" y="67">Preprocessor</text>
    <text class="fg-sub" x="336" y="86">Preprocessor.py</text>
    <g class="fg-tag">
      <rect x="312" y="28" width="48" height="16"></rect>
      <text x="336" y="39.5">[ 02 ]</text>
    </g>
  </g>

  <!-- 03 -->
  <g class="fg-part" data-step="03">
    <rect class="fg-box" x="456" y="40" width="192" height="64"></rect>
    <text class="fg-name" x="552" y="67">Parse · symbols</text>
    <text class="fg-sub" x="552" y="86">CParser · RISCVGenerator</text>
    <g class="fg-tag">
      <rect x="528" y="28" width="48" height="16"></rect>
      <text x="552" y="39.5">[ 03 ]</text>
    </g>
  </g>

  <!-- 04 -->
  <g class="fg-part" data-step="04">
    <rect class="fg-box" x="672" y="40" width="192" height="64"></rect>
    <text class="fg-name" x="768" y="67">Labeled trees</text>
    <text class="fg-sub" x="768" y="86">subject · action · object</text>
    <g class="fg-tag">
      <rect x="744" y="28" width="48" height="16"></rect>
      <text x="768" y="39.5">[ 04 ]</text>
    </g>
  </g>

  <!-- 05 -->
  <g class="fg-part" data-step="05">
    <rect class="fg-box" x="888" y="40" width="192" height="64"></rect>
    <text class="fg-name" x="984" y="67">Address resolution</text>
    <text class="fg-sub" x="984" y="86">label → 0x30000 + off</text>
    <g class="fg-tag">
      <rect x="960" y="28" width="48" height="16"></rect>
      <text x="984" y="39.5">[ 05 ]</text>
    </g>
  </g>

  <!-- Row 1 flow -->
  <path class="fg-wire" d="M216 72 H231"></path>
  <polygon class="fg-head" points="240,72 231,67 231,77"></polygon>
  <path class="fg-wire" d="M432 72 H447"></path>
  <polygon class="fg-head" points="456,72 447,67 447,77"></polygon>
  <path class="fg-wire" d="M648 72 H663"></path>
  <polygon class="fg-head" points="672,72 663,67 663,77"></polygon>
  <path class="fg-wire" d="M864 72 H879"></path>
  <polygon class="fg-head" points="888,72 879,67 879,77"></polygon>

  <!-- 05 down into the .policy_meta cell of the binary -->
  <path class="fg-wire" d="M984 104 V142 H948 V167"></path>
  <polygon class="fg-head" points="948,176 943,167 953,167"></polygon>

  <!-- ===================== THE BINARY (06) ====================== -->
  <g class="fg-part" data-step="06">
    <rect class="fg-fill" x="24" y="176" width="1056" height="92"></rect>
    <rect class="fg-box" x="24" y="176" width="1056" height="92"></rect>
    <path class="fg-wire" d="M24 204 H1080" stroke-width="1"></path>

    <text
      class="fg-sub"
      x="98"
      y="196"
      text-anchor="start"
      style="letter-spacing:0.08em">program.elf</text
    >
    <text
      class="fg-sub"
      x="1066"
      y="196"
      text-anchor="end"
      style="letter-spacing:0.08em">RISC-V ELF32 · policy-carrying</text
    >

    <!-- Section cells -->
    <path class="fg-wire" d="M288 204 V268" stroke-width="1"></path>
    <path class="fg-wire" d="M552 204 V268" stroke-width="1"></path>
    <path class="fg-wire" d="M816 204 V268" stroke-width="1"></path>

    <text class="fg-name" x="156" y="232" style="font-size:12px">.text</text>
    <text class="fg-sub" x="156" y="250">instructions</text>
    <text class="fg-name" x="420" y="232" style="font-size:12px">.data</text>
    <text class="fg-sub" x="420" y="250">globals</text>
    <text class="fg-name" x="684" y="232" style="font-size:12px">.text_tag</text>
    <text class="fg-sub" x="684" y="250">per-instruction label</text>
    <text class="fg-name" x="948" y="232" style="font-size:12px"
      >.policy_meta</text
    >
    <text class="fg-sub" x="948" y="250">the policy table</text>

    {/* Seated on the top edge like every other tag, and inside the bar's own
        width — hung off the corner it read as a label for nothing. */}
    <g class="fg-tag">
      <rect x="32" y="168" width="48" height="16"></rect>
      <text x="56" y="179.5">[ 06 ]</text>
    </g>
  </g>

  <!-- The boundary the artifact crosses -->
  <path class="fg-bound" d="M0 312 H1200"></path>
  <text class="fg-zone" x="1176" y="336" text-anchor="end">
    Runtime · FlexSiMArch
  </text>

  <!-- .text loads into memory -->
  <path class="fg-wire" d="M120 268 V363"></path>
  <polygon class="fg-head" points="120,372 115,363 125,363"></polygon>

  <!-- .text_tag and .policy_meta converge on the enforcement unit -->
  <path class="fg-wire" d="M948 268 V340 H768 V363"></path>
  <path class="fg-wire" d="M684 268 V340"></path>
  <polygon class="fg-head" points="768,372 763,363 773,363"></polygon>
  <circle class="fg-head" cx="768" cy="340" r="3.5"></circle>
  <text
    class="fg-sub"
    x="962"
    y="296"
    text-anchor="start"
    style="letter-spacing:0.08em">loaded before instruction 0</text
  >

  <!-- ========================= RUNTIME ========================== -->
  <!-- 07 -->
  <g class="fg-part" data-step="07">
    <rect class="fg-box" x="24" y="372" width="192" height="64"></rect>
    <text class="fg-name" x="120" y="399">Loader</text>
    <text class="fg-sub" x="120" y="418">BIOS · ELF loader</text>
    <g class="fg-tag">
      <rect x="96" y="360" width="48" height="16"></rect>
      <text x="120" y="371.5">[ 07 ]</text>
    </g>
  </g>

  <!-- 08 -->
  <g class="fg-part" data-step="08">
    <rect class="fg-box" x="240" y="372" width="192" height="64"></rect>
    <text class="fg-name" x="336" y="399">Sparse memory</text>
    <text class="fg-sub" x="336" y="418">RAM · RV64</text>
    <g class="fg-tag">
      <rect x="312" y="360" width="48" height="16"></rect>
      <text x="336" y="371.5">[ 08 ]</text>
    </g>
  </g>

  <!-- 09 -->
  <g class="fg-part" data-step="09">
    <rect class="fg-box" x="456" y="372" width="192" height="64"></rect>
    <text class="fg-name" x="552" y="399">Hardware thread</text>
    <text class="fg-sub" x="552" y="418">Hart · Capstone · Executor</text>
    <g class="fg-tag">
      <rect x="528" y="360" width="48" height="16"></rect>
      <text x="552" y="371.5">[ 09 ]</text>
    </g>
  </g>

  <!-- 10 — the enforcement unit -->
  <g class="fg-part" data-step="10">
    <rect class="fg-fill" x="672" y="372" width="192" height="64"></rect>
    <rect class="fg-box" x="672" y="372" width="192" height="64"></rect>
    <text class="fg-name" x="768" y="399">Policy check</text>
    <text class="fg-sub" x="768" y="418">O(1) prefix match</text>
    <g class="fg-tag">
      <rect x="744" y="360" width="48" height="16"></rect>
      <text x="768" y="371.5">[ 10 ]</text>
    </g>
  </g>

  <!-- Row 2 flow -->
  <path class="fg-wire" d="M216 404 H231"></path>
  <polygon class="fg-head" points="240,404 231,399 231,409"></polygon>
  <path class="fg-wire" d="M432 404 H447"></path>
  <polygon class="fg-head" points="456,404 447,399 447,409"></polygon>
  <path class="fg-wire" d="M648 404 H663"></path>
  <polygon class="fg-head" points="672,404 663,399 663,409"></polygon>

  <!-- Every access forks here. Both outcomes are drawn; neither is an edge case. -->
  <path class="fg-wire" d="M864 404 H892 V378 H911"></path>
  <path class="fg-wire" d="M892 404 V454 H911"></path>
  <polygon class="fg-head" points="920,378 911,373 911,383"></polygon>
  <polygon class="fg-head" points="920,454 911,449 911,459"></polygon>
  <circle class="fg-head" cx="892" cy="404" r="3.5"></circle>

  <!-- 11 permitted -->
  <g class="fg-part" data-step="11">
    <rect class="fg-box" x="920" y="352" width="256" height="52"></rect>
    <text class="fg-name" x="1048" y="375">Access reaches memory</text>
    <text class="fg-sub" x="1048" y="392">56 of 7,381 combinations</text>
  </g>

  <!-- 12 denied — the default, and the only part drawn in the second signal -->
  <g class="fg-part" data-step="12">
    <rect
      class="fg-box"
      x="920"
      y="428"
      width="256"
      height="52"
      stroke="var(--deny)"></rect>
    <text class="fg-name" x="1048" y="451" fill="var(--deny)"
      >Denied before memory</text
    >
    <text class="fg-sub" x="1048" y="468">7,325 · deny by default</text>
  </g>
</svg>
